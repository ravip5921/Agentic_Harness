# Choose groq, gemini, or openai-compatible. Groq remains the default.
LLM_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-20b

# To use Gemini, set LLM_PROVIDER=gemini and provide its key:
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# GEMINI_MODEL=gemini-3.8-flash

# Optional settings shared by all providers:
LLM_MAX_OUTPUT_TOKENS=16384
LLM_TIMEOUT_SECONDS=90
# LLM_MODEL overrides the selected provider's model setting.
# LLM_MODEL=your-model-id
# LLM_API_KEY overrides the selected provider's API key.
# LLM_API_KEY=your-key

# For LLM_PROVIDER=openai-compatible, set all three:
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=your-model-id
# LLM_API_KEY=your-key
